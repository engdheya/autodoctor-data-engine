# AutoDoctor Data Integration Engine - local configuration
# Copy to .env and adjust. All variables are optional.

# Where the upstream repositories are checked out (default: vendor/upstream).
# AUTODOCTOR_UPSTREAM_DIR=/absolute/path/to/checkouts

# Project root (default: current working directory).
# AUTODOCTOR_ROOT=/absolute/path/to/autodoctor-data-engine

# Working database path (default: <root>/db/autodoctor.sqlite).
# AUTODOCTOR_DB=/absolute/path/to/autodoctor.sqlite

# The corroboration threshold lives in config/sources.yaml under
# rules.min_corroborating_lineages (default: 2 lineages).

# Set to 1 to exercise the real upstream checkouts in the test suite.
# AUTODOCTOR_INTEGRATION=0

# GitHub token used by `autodoctor fetch-sources` when cloning OBDb vehicle
# repositories (needed to avoid anonymous rate limits in CI).
# GITHUB_TOKEN=
